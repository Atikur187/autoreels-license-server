# ==============================================================================
# AutoReels Scroll — Environment Configuration (.env.example)
# Copy this file to .env.local in license-server/ for development,
# or configure these in your production host (e.g. Vercel Project Settings).
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. PADDLE BILLING ENVIRONMENT & CLIENT CONFIGURATION
# ------------------------------------------------------------------------------
# PADDLE_ENV: Set to 'sandbox' for local development/testing, or 'production' for live payments.
PADDLE_ENV=sandbox

# PADDLE_CLIENT_TOKEN: Client-side token from Paddle Dashboard -> Developer Settings -> Authentication.
# Safe for frontend initialization.
# In Sandbox: Starts with 'test_' (e.g., test_a1b2c3d4e5f6...)
# In Production: Starts with 'live_' (e.g., live_a1b2c3d4e5f6...)
# IMPORTANT: Never use test_ tokens in production or live_ tokens in sandbox.
PADDLE_CLIENT_TOKEN=test_sample_client_token

# ------------------------------------------------------------------------------
# 2. PADDLE SERVER-SIDE SECRETS (NEVER EXPOSE TO CLIENT OR EXTENSION)
# ------------------------------------------------------------------------------
# PADDLE_API_KEY: Paddle Secret API key with full catalog and transaction read permissions.
PADDLE_API_KEY=pdl_api_secret_key_here

# PADDLE_WEBHOOK_SECRET: Secret key from Paddle Dashboard -> Notifications -> Webhook Destination.
# Used for cryptographically verifying HMAC-SHA256 signatures on /api/paddle/webhook.
PADDLE_WEBHOOK_SECRET=pdl_whsec_webhook_secret_here

# ------------------------------------------------------------------------------
# 3. PADDLE PRICE IDs (From Paddle Dashboard -> Catalog -> Products & Prices)
# All real Paddle Price IDs start with 'pri_'
# ------------------------------------------------------------------------------
# Monthly Pass ($1.49)
PADDLE_PRICE_MONTHLY=pri_sample_monthly_149

# 1 Year Pro ($9.49)
PADDLE_PRICE_YEARLY=pri_sample_yearly_949

# Lifetime VIP ($19.99)
PADDLE_PRICE_LIFETIME=pri_sample_lifetime_1999

# ------------------------------------------------------------------------------
# 4. SUPABASE DATABASE CONFIGURATION (From Supabase Dashboard -> Settings -> API)
# ------------------------------------------------------------------------------
# Public Supabase URL (client-safe)
SUPABASE_URL=https://your-project-ref.supabase.co

# Public Anonymous Key (client-safe)
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Service Role Secret Key (SERVER-SIDE ONLY - NEVER EXPOSE TO CLIENT)
# Required for license server write operations and webhook fulfillment
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ------------------------------------------------------------------------------
# 5. ADMIN AUTHENTICATION SECRET
# ------------------------------------------------------------------------------
ADMIN_API_KEY=admin-secret-key-change-in-production

# ------------------------------------------------------------------------------
# 6. APPLICATION URL
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3500
