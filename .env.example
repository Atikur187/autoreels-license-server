# ==============================================================================
# AutoReels Scroll — Environment Configuration Template (.env.example)
# Never commit real secret keys to version control.
# Copy this file to .env.local for local development, or add these
# variables into your production hosting dashboard (e.g. Vercel Project Settings).
# ==============================================================================

# Paddle Environment ('sandbox' for testing, 'production' for live payments)
PADDLE_ENV=sandbox

# Public Client Token for Frontend Paddle.js initialization
# Starts with 'test_' in sandbox or 'live_' in production
PADDLE_CLIENT_TOKEN=test_your_client_side_token_here

# Paddle Server-Side Secret API Key (NEVER expose to frontend or extension)
PADDLE_API_KEY=pdl_sdbx_apikey_your_secret_here

# Paddle Webhook Secret (From Paddle Dashboard -> Notifications -> Destination Secret)
PADDLE_WEBHOOK_SECRET=pdl_ntfset_your_webhook_secret_here

# Paddle Price IDs (Starts with 'pri_')
PADDLE_PRICE_MONTHLY=pri_01m2b6436f3ss2z4a2zphtx2r2
PADDLE_PRICE_YEARLY=pri_01m2b649m3xr3rey1zepakqza8
PADDLE_PRICE_LIFETIME=pri_01m2b649zy4hemgsgazma491fj

# Supabase Database Configuration
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=your_supabase_anon_key_here
SUPABASE_SECRET_KEY=your_supabase_service_role_secret_key_here

# Optional Admin Portal API Key
ADMIN_API_KEY=admin-secret-key-change-in-production
