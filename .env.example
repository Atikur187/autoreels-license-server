# ==============================================================================
# AutoReels Scroll — Environment Configuration Template (.env.example)
# Never commit real secret keys to version control.
# Copy this file to .env.local for local development, or add these
# variables into your production hosting dashboard (e.g. Vercel Project Settings).
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Lemon Squeezy Payment Gateway Configuration
# ------------------------------------------------------------------------------
# Set to 'test' for Sandbox / Test Mode, or 'live' for Production Live Mode
LEMON_SQUEEZY_MODE=test

# Official Lemon Squeezy API Key
# Test Mode: Dashboard -> Settings -> API Keys (while in Test Mode)
# Live Mode: Dashboard -> Settings -> API Keys (while in Live Mode)
LEMON_SQUEEZY_API_KEY=

# Numeric Lemon Squeezy Store ID
# Obtain from: Lemon Squeezy Dashboard -> Settings -> Stores (number next to store name)
LEMON_SQUEEZY_STORE_ID=

# Lemon Squeezy Product Variant IDs (One-time payments)
# Obtain from: Lemon Squeezy Dashboard -> Products -> (Select Product) -> Variants tab -> Click variant -> ID in URL or copy variant ID
LEMON_SQUEEZY_VARIANT_MONTHLY=
LEMON_SQUEEZY_VARIANT_YEARLY=
LEMON_SQUEEZY_VARIANT_LIFETIME=

# Lemon Squeezy Webhook Signing Secret (Raw body HMAC-SHA256 verification)
# Obtain from: Lemon Squeezy Dashboard -> Settings -> Webhooks -> Add/Edit Webhook
LEMON_SQUEEZY_WEBHOOK_SECRET=

# ------------------------------------------------------------------------------
# 2. Supabase Database Configuration
# ------------------------------------------------------------------------------
# Project URL from Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=

# Secret service_role key with elevated permissions (NEVER expose to browser/client)
# Obtain from: Supabase Dashboard -> Project Settings -> API -> Project API Keys -> service_role (secret)
SUPABASE_SECRET_KEY=

# Optional fallback alias used in legacy environments:
# SUPABASE_SERVICE_ROLE_KEY=

# ------------------------------------------------------------------------------
# 3. Application Base URL
# ------------------------------------------------------------------------------
# Production canonical website URL used for webhook callbacks and customer redirects
APP_BASE_URL=https://autoreels-license-server.vercel.app

# ------------------------------------------------------------------------------
# 4. Administrator Security & Authorization
# ------------------------------------------------------------------------------
# Private master password for Master Admin login gate (/admin)
ADMIN_API_KEY=admin-secret-key-change-in-production

# Comma-separated list of authorized administrator emails for Supabase login
ADMIN_EMAILS=
